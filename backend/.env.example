# Neon PostgreSQL bağlantı dizesi (gerçek değeri commit etmeyin)
DATABASE_URL=

# Sunucu portu (Render/Railway genelde PORT'u otomatik verir)
PORT=5000

# Ortam
NODE_ENV=development

# Frontend URL (CORS ve Socket.IO için)
# Kod tabanı CLIENT_URL, CORS_ORIGIN ve FRONTEND_URL destekler.
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Production örneği (wildcard * KULLANMAYIN):
# NODE_ENV=production
# CLIENT_URL=https://app.ornek.com
# CORS_ORIGIN=https://app.ornek.com
# FRONTEND_URL=https://app.ornek.com

# JWT imzalama anahtarı — production'da güçlü ve uzun bir değer kullanın
# Örnek: openssl rand -base64 48
JWT_SECRET=

# LiveKit (voice chat — gerçek sesli sohbet için zorunlu)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Captcha (production öncesi önerilir — Sprint 30 placeholder)
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# Redis (realtime ölçekleme — Sprint 33)
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379

# Production örneği:
# ENABLE_REDIS=true
# REDIS_URL=redis://:password@your-redis-host:6379

# Email (Resend — Sprint 38)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000

# Stripe (Premium ödeme — test mode önerilir; live ayrı yapılandırma)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=

# Beta mode (Sprint 39)
BETA_MODE=true
BETA_ACCESS_REQUIRED=true

# Demo seed — production'da varsayılan engellenir
# Bilinçli demo seed için: ALLOW_DEMO_SEED=true (yalnızca test ortamında)

# Production checklist: DEPLOYMENT.md · PRODUCTION_CHECKLIST.md
